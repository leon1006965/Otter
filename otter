        self.bar.set_hexpand(True)
        self.bar.set_show_text(True)
        self.bar.set_text("idle")
        pr.pack_start(self.bar, True, True, 0)
        self.bytes_lbl = Gtk.Label(xalign=1)
        self.bytes_lbl.set_width_chars(22)
        pr.pack_start(self.bytes_lbl, False, False, 0)
        self.btn_start = Gtk.Button(label="Start")
        self.btn_start.get_style_context().add_class("suggested-action")
        self.btn_start.set_size_request(140, 36)
        self.btn_start.connect("clicked", lambda *_: self._on_stop()
                               if self.running else self._on_start())
        pr.pack_start(self.btn_start, False, False, 0)
        outer.pack_start(pr, False, False, 0)

        # ---- log: the biggest thing on screen, like Odin3 -----------------
        frame = Gtk.Frame(label="Log")
        frame.set_shadow_type(Gtk.ShadowType.NONE)
        fb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        fb.set_border_width(4)
        self.logbuf = Gtk.TextBuffer()
        self.logbuf.create_tag("err", foreground="#c01c28", weight=Pango.Weight.BOLD)
        self.logbuf.create_tag("warn", foreground="#a2734c")
        self.logbuf.create_tag("ok", foreground="#2ec27e")
        self.logbuf.create_tag("cmd", foreground="#3584e4", weight=Pango.Weight.BOLD)
        view = Gtk.TextView(buffer=self.logbuf, editable=False, cursor_visible=False)
        view.set_monospace(True)
        self._logview = view
        sw = Gtk.ScrolledWindow()
        sw.set_min_content_height(160)
        sw.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
