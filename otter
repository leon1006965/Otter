    # ----------------------------------------------------------------- sizing

    def _fit_to_screen(self):
        """Size the window so its visible bottom sits just above the panel."""
        try:
            wa = Gdk.Display.get_default().get_monitor(0).get_workarea()
        except Exception:
            return
        want = min(780, wa.height - 40 - self.CSD_OVERHEAD)
        want = max(want, self.get_preferred_height()[0])
        if want == self._req_h:
            return
        self._req_h = want
        self.resize(min(900, wa.width - 20), want)

    def _load_state(self):
        """Restore the identity from the last probe.

        A phone accepts ONE session per Download-mode entry, so forcing a new
        probe after every restart is what made Start impossible to reach in
        the same take.  The CLI still compares --confirm against the *live*
        device identity, so a stale value can only make the flash refuse - it
        can never make it write to the wrong phone.
        """
        try:
            with open(STATE_FILE) as f:
                for line in f:
                    if line.startswith("identity="):
                        v = line.split("=", 1)[1].strip()
                        if v and v != "-":
                            self.identity = v
                            self.identity_lbl.set_markup(
                                "<b>%s</b> <i>(cached)</i>" % esc(v))
                            return v
        except OSError:
            pass
        return ""

    def _save_state(self):
        try:
            with open(STATE_FILE, "w") as f:
                f.write("identity=%s\n" % (self.identity or "-"))
        except OSError as e:
            self._log("[otter] could not save state: %s" % e, "warn")

    def _popup(self, title, primary, secondary, mtype=Gtk.MessageType.INFO):
        """Modal note.  Never blocks anything: it only explains what to do."""
        d = Gtk.MessageDialog(transient_for=self, modal=True, message_type=mtype,
                              buttons=Gtk.ButtonsType.OK)
        d.set_title(title)
        d.set_markup("<b>%s</b>\n\n%s" % (esc(primary), esc(secondary)))
        d.run()
        d.destroy()

    def _popup_after_probe(self):
        self._popup(
            "Probe complete",
            "Probed %s - device PIT saved." % (self.identity or "?"),
            "The phone has just used its ONE session for this Download-mode "
            "entry, so pressing Start right now would fail.\n\n"
            "Power the phone off and re-enter Download mode, then press "
            "Start.\n\n"
            "The identity and partition table are remembered - you will not "
            "be asked to Probe again.",
            Gtk.MessageType.WARNING)

    def _popup_session_lost(self):
        self._popup(
            "The phone will not open a session",
            "No \"LOKE\" - this Download-mode entry has already been used.",
            "Power the phone off and re-enter Download mode, then press "
            "Start again.\n\nNothing was written to the phone.",
            Gtk.MessageType.WARNING)

    def _popup_flash_done(self):
        self._popup(
            "Flash complete",
            "Everything was written and the session was closed cleanly.",
            "The phone is still in Download mode. If you want to flash "
            "again, power it off and re-enter Download mode first.",
            Gtk.MessageType.INFO)

    def _set_status(self, text):
        if getattr(self, "header", None):
            self.header.set_subtitle(text)

    # ------------------------------------------------------------ file pick

    def _pick(self, key):
        dlg = Gtk.FileChooserDialog(title="Choose a " + key + " file",
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button("_Open", Gtk.ResponseType.ACCEPT)
        cur = self.filers[key].entry.get_text()
        if cur and os.path.isfile(cur):
            dlg.set_filename(cur)
        resp = dlg.run()
        fn = dlg.get_filename() if resp == Gtk.ResponseType.ACCEPT else None
        dlg.destroy()
        if fn:
            self.filers[key].set(fn)
            self._log("$ " + os.path.basename(fn) + "  ->  " + key)

    def _pick_pit(self):
        dlg = Gtk.FileChooserDialog(title="Choose a PIT",
                                    action=Gtk.FileChooserAction.OPEN)
        dlg.add_button("_Cancel", Gtk.ResponseType.CANCEL)
        dlg.add_button("_Open", Gtk.ResponseType.ACCEPT)
        resp = dlg.run()
        fn = dlg.get_filename() if resp == Gtk.ResponseType.ACCEPT else None
        dlg.destroy()
        if fn:
            self.repart_pit.set_text(fn)

    def _slot_changed(self):
        self.plan_rows = []          # any change invalidates a previewed plan
        self.skip_rows = []
        self._update_actions()

    def _opt_changed(self):
        self.pit_row.set_visible(self.flags["repartition"].get_active())
        self.plan_rows = []
        self.skip_rows = []

    # --------------------------------------------------------------- logging

    def _log(self, line, tag=None):
        it = self.logbuf.get_end_iter()
        if tag:
            self.logbuf.insert_with_tags_by_name(it, line + "\n", tag)
        else:
            self.logbuf.insert(it, line + "\n")
        end = self.logbuf.get_end_iter()
        mark = self.logbuf.create_mark(None, end, False)
        # keep the tail visible if the user is not scrolling
        tv = self._logview if getattr(self, "_logview", None) else None
        if tv:
            tv.scroll_to_mark(mark, 0.0, False, 0.0, 1.0)
        self.logbuf.delete_mark(mark)

    def _tag_for(self, line):
        if line.startswith("error:") or "refus" in line or "failed" in line \
                or line.startswith(("[io] no data from",
                                    "[io] the device stopped accepting")):
            return "err"
        if line.startswith(("[usb]", "[proto]", "[pit]", "[otter]", "[io]",
                            "warning")):
            return "warn"
        if line.startswith("OTTER"):
            return None
        return None

    # ------------------------------------------------------------- plumbing

    def _run(self, kind, args):
        if self.running:
            return
        if not self.driver:
            self._log("error: odin3-linux binary not found", "err")
            return
        self.kind = kind
        self.rec = {}
        self._loke_fail = False
        if kind == "list":
            self.devlist = []
        self.plan_rows = []          # always recompute, never reuse
        self.skip_rows = []
        self._interrupted = False
        self.running = True
        self._have_progress = False
        self._update_actions()
        self._start_pulse()
        self._set_status("working…")
        argv = [self.driver] + args + ["--machine"]
        self._log("$ " + " ".join(os.path.basename(a) for a in argv), "cmd")
        threading.Thread(target=self._worker, args=(argv,), daemon=True).start()

    def _worker(self, argv):
        try:
            p = subprocess.Popen(argv, stdout=subprocess.PIPE,
                                 stderr=subprocess.STDOUT, text=True, bufsize=1)
        except Exception as e:
            GLib.idle_add(self._log, "error: " + str(e), "err")
            GLib.idle_add(self._done, 1)
            return
        self.proc = p
        for line in p.stdout:
            GLib.idle_add(self._line, line.rstrip("\n"))
        rc = p.wait()
        GLib.idle_add(self._done, rc)

    def _line(self, line):
        if line.startswith("OTTER\t"):
            parts = line.split("\t")
            key = parts[1]
            if key == "PLAN":
                self.plan_rows.append(parts[2:])
            elif key == "SKIP" and len(parts) >= 4:
                self.skip_rows.append((parts[2], "\t".join(parts[3:])))
            elif key == "PROGRESS" and len(parts) >= 4:
                try:
                    done, total = int(parts[2]), int(parts[3])
                except ValueError:
                    return False
                if total > 0:
                    self._have_progress = True
                    f = min(1.0, done / total)
                    self.bar.set_fraction(f)
                    self.bar.set_text("%d%%" % int(f * 100))
                    self.bytes_lbl.set_text("%s / %s" % (fmt(done), fmt(total)))
            else:
                self.rec[key] = "\t".join(parts[2:])
            return False
        # The driver reports a long wait instead of sitting silent.  Mirror it
        # in the status line and on the bar, because a frozen percentage with
        # a quiet log is indistinguishable from a hang - which is exactly what
        # a stalled bulk OUT looked like before the write path reported too.
        if line.startswith("[io] still"):
            # The bar keeps its fraction (and the byte label keeps the exact
            # count) - only the percentage text becomes "waiting…", so the
            # difference between "progressing slowly" and "the device has
            # stopped answering" is visible instead of both looking frozen.
            self._set_status(line[len("[io] "):].rstrip("."))
            if self.running:
                self.bar.set_text("waiting…")
            self._log(line, self._tag_for(line))
            return False
        if line.startswith('[proto] handshake: no "LOKE"'):
            self._loke_fail = True
        if self.kind == "list":
            m = re.match(r"\s+([0-9a-f]{4}):([0-9a-f]{4})\b", line)
            if m:
                self.devlist.append(("usb", m.group(1), m.group(2)))
            else:
                m = re.match(r"\s+(/dev/tty(?:ACM|USB)\d+)\b", line)
                if m:
                    self.devlist.append(("serial", m.group(1), ""))
        self._log(line, self._tag_for(line))
        return False

    def _done(self, rc):
        self.running = False
        self.proc = None
        self._stop_pulse()
        kind = self.kind

        if rc == 0:
            self._log("[otter] ok (exit 0)", "ok")
            if kind == "list":
                self._fill_devices()
                self._set_status("device list refreshed")
            elif kind == "probe":
                self.identity = self.rec.get("IDENTITY", "")
                n = self.rec.get("PITCOUNT", "?")
                self.identity_lbl.set_markup("<b>%s</b>" % esc(self.identity or "?"))
                self._save_state()
                self._log("[otter] probed %s, device PIT saved (%s entries)"
                          % (self.identity or "?", n), "ok")
                self._set_status("%s - re-enter Download mode before Start"
                                 % (self.identity or "?"))
                self.bar.set_fraction(0); self.bar.set_text("idle")
                self.bytes_lbl.set_text("")
                self._popup_after_probe()
            elif kind == "preflight":
                self._log("[otter] every pre-flight gate passed", "ok")
                self._set_status("plan OK - confirm to continue")
                self._ask_then_flash()
            elif kind == "flash":
                self.identity = self.rec.get("IDENTITY") or self.identity
                self.bar.set_fraction(1.0); self.bar.set_text("done")
                self._log("[otter] flash complete", "ok")
                self._set_status("flash complete")
                self._popup_flash_done()
            elif kind == "plan":
                self._set_status("plan checked")
        elif self._interrupted:
            # already logged by _on_stop; an interrupt is a choice, not a
            # fault, so it must not be reported as a failure nor trigger one
            if self.bar.get_fraction() < 1.0:
                self.bar.set_text("stopped")
        else:
            self._log("[otter] failed (exit %s) - see the log; nothing further "
                      "was sent" % rc, "err")
            self._set_status("failed - see the log")
            if self.bar.get_fraction() < 1.0:
                self.bar.set_text("failed")
            if kind == "preflight":
                self._log("[otter] Start cancelled: the gates above refused",
                          "err")
            elif kind == "flash" and self._loke_fail:
                self._popup_session_lost()
        self._update_actions()
        return False

    # ------------------------------------------------------------ devices

    def _fill_devices(self):
        self.devs.remove_all()
        usb = [d for d in self.devlist if d[0] == "usb"]
        ser = [d for d in self.devlist if d[0] == "serial"]
        for _, v, p in usb:
            self.devs.append_text("%s:%s" % (v, p))
        for _, path, _ in ser:
            self.devs.append_text(path)
        if usb:
            self.devs.set_active(0)
            self.vid.set_text(usb[0][1])
            self.pid.set_text(usb[0][2])
            self.transport.set_active_id("usb")
        elif ser:
            self.devs.set_active(0)
            self._on_dev_changed(self.devs)
        else:
            self._log("[otter] no device found - is the phone in Download mode?",
                      "warn")

    def _on_dev_changed(self, combo):
        v = combo.get_active_text() or ""
        if v.startswith("/dev/"):
            self.serial_path = v
            self.transport.set_active_id("serial")
        elif re.match(r"^[0-9a-f]{4}:[0-9a-f]{4}$", v):
            self.serial_path = ""
            self.vid.set_text(v[:4])
            self.pid.set_text(v[5:])
            self.transport.set_active_id("usb")

    # ------------------------------------------------------------- commands

    def _transport_args(self):
        mode = self.transport.get_active_id() or "auto"
        if mode == "serial":
            out = ["--transport", "serial"]
            if self.serial_path:
                out += ["--device", self.serial_path]
            return out
        if mode == "auto":
            return []                      # let the CLI discover everything
        out = ["--transport", "usb"]
        if self.vid.get_text().strip():
            out += ["--vid", self.vid.get_text().strip()]
        if self.pid.get_text().strip():
            out += ["--pid", self.pid.get_text().strip()]
        return out

    def _slot_args(self):
        out = []
        for key, _ in SLOTS:
            p = self.filers[key].get()
            if p:
                out += ["--" + key.lower(), p]
        return out

    def _flag_args(self):
        out = []
        if self.flags["repartition"].get_active():
            out.append("--repartition")
            p = self.repart_pit.get_text().strip()
            if p:
                out += ["--pit", p]
        for k, cli in (("reboot", "--reboot"), ("lock", "--lock"),
                       ("erase", "--erase"),
                       ("allow_critical", "--allow-critical-partitions"),
                       ("allow_oversize", "--allow-oversize"),
                       ("allow_model", "--allow-model-mismatch"),
                       ("allow_duplicate", "--allow-duplicate-targets")):
            if self.flags[k].get_active():
                out.append(cli)
        return out

    def _run_list(self):
        self._run("list", ["list"])

    def _run_probe(self):
        self._run("probe", ["probe"] + self._transport_args() +
                  ["--save-pit", self.pit_path])

    def _on_start(self):
        if self.running:
            return
        if not self._slot_args():
            self._log("error: choose at least one file first", "err")
            return
        if not self.identity:
            self._log("error: press Probe first - the confirm token is the "
                      "device identity and it is not known yet", "err")
            return
        if self.flags["repartition"].get_active() \
                and not self.repart_pit.get_text().strip():
            self._log("error: Re-Partition is ticked but no PIT file is chosen",
                      "err")
            return
        if os.path.isfile(self.pit_path):
            # Run every gate offline first: if anything is refused we never
            # get as far as the confirmation dialog, let alone the phone.
            self._run("preflight", ["plan"] + self._slot_args() +
                      ["--pit", self.pit_path] + self._flag_args())
        else:
            self._ask_then_flash()

    def _ask_then_flash(self):
        """Show exactly what will be written, then ask.

        Every plan row is listed as `member -> PARTITION (bytes)` - with a
        full firmware that is tens of rows, and Gtk.MessageDialog does not
        scroll, so past a handful the list goes into a capped scroll view
        instead of running off the bottom of the screen.
        """
        rows = self.plan_rows
        if rows:
            body = "\n".join("%s  ->  %s   (%s bytes)"
                             % (r[1], r[3], f"{int(r[4]):,}") for r in rows)
            summary = "%d file(s) -> %d partition(s)" % (
                len(rows), len({r[3] for r in rows}))
        else:
            body = "\n".join(os.path.basename(p) for p in _paths(self))
            summary = "no saved device PIT, so no partition preview"

        # Members the pre-flight dropped (unknown folder, odd typeflag, no
        # matching partition) - listed so "it was ignored" is never a
        # surprise the user discovers afterwards.
        if self.skip_rows:
            body += "\n\nNOT flashed (%d):\n" % len(self.skip_rows) + "\n".join(
                "  %-42s %s" % (n[:42], why) for n, why in self.skip_rows)
            summary += ", %d skipped" % len(self.skip_rows)

        dlg = Gtk.MessageDialog(transient_for=self, modal=True,
                                message_type=Gtk.MessageType.WARNING,
                                buttons=Gtk.ButtonsType.OK_CANCEL)
        dlg.set_title("Start flash")
        dlg.set_markup("<b>Write to %s ?</b>\n\n%s\n\n"
                       "The phone must be in Download mode."
                       % (esc(self.identity), esc(summary)))

        # The dialog cannot scroll, so anything longer than a few lines goes
        # into a capped scroll view - counted over the whole body, skips
        # included, or a long "NOT flashed" list would still run off screen.
        nlines = body.count("\n") + 1
        if nlines > 6:
            sw = Gtk.ScrolledWindow()
            sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            sw.set_propagate_natural_height(True)
            sw.set_min_content_height(22 * min(nlines, 6))
            sw.set_max_content_height(320)
            tv = Gtk.TextView()
            tv.set_editable(False)
            tv.set_cursor_visible(False)
            tv.set_monospace(True)
            tv.get_buffer().set_text(body)
            sw.add(tv)
            dlg.get_message_area().pack_start(sw, True, True, 0)
        else:
            lbl = Gtk.Label(label=body, xalign=0, selectable=True)
            lbl.set_justify(Gtk.Justification.LEFT)
            dlg.get_message_area().pack_start(lbl, False, False, 0)

        dlg.show_all()
        if dlg.run() != Gtk.ResponseType.OK:
            dlg.destroy()
            self._set_status("cancelled - nothing was written")
            return
        dlg.destroy()
        self._run("flash", ["flash"] + self._slot_args() + self._transport_args() +
                  ["--flash", "--confirm", self.identity,
                   "--expect-model", self.identity] + self._flag_args())

    # --------------------------------------------------------------- state

    def _on_stop(self):
        """Interrupt a running command.

        The driver now waits Odin's full 300 s for a response, so a phone
        that has gone quiet can hold the window for minutes with nothing to
        look at.  Interrupting mid-write is safe in the sense that matters:
        the driver sends no further command, the phone keeps whatever it has
        and stays in Download mode - exactly the state a failed run leaves.
        """
        p = self.proc
        if p is None:
            return
        kind = self.kind
        self._interrupted = True
        self._log("[otter] interrupted by the user" +
                  ("" if kind != "flash" else
                   " - the phone keeps the bytes already written and stays "
                   "in Download mode; re-enter Download mode before retrying"),
                  "warn")
        self._set_status("interrupted")
        try:
            p.terminate()
        except Exception:
            pass

        # If it does not exit promptly it is wedged inside a read; escalate
        # rather than leave the window spinning forever.
        def force():
            if p.poll() is None:
                try:
                    p.kill()
                except Exception:
                    pass
        t = threading.Timer(3.0, force)
        t.daemon = True                 # never hold the process open for us
        t.start()

    def _update_actions(self):
        if not hasattr(self, "btn_start"):
            return
        if self.running:
            # Odin bounds every read at 300 s; the button must be the way out
            # of that wait rather than greyed out for its whole length.
            self.btn_start.set_sensitive(True)
            self.btn_start.set_label("Stop")
            self.btn_start.get_style_context().add_class("destructive-action")
            return
        self.btn_start.get_style_context().remove_class("destructive-action")
        ok = bool(self.driver) and bool(self._slot_args()) and bool(self.identity)
        self.btn_start.set_sensitive(ok)
        self.btn_start.set_label("Start")

    def _start_pulse(self):
        if self._pulse:
            return
        self._have_progress = False

        def tick():
            if not self.running or self._have_progress:
                self._pulse = None
                return False
            self.bar.pulse()
            return True
        self._pulse = GLib.timeout_add(90, tick)

    def _stop_pulse(self):
        if self._pulse:
            GLib.source_remove(self._pulse)
            self._pulse = None


def fmt(n):
    for unit in ("B", "KiB", "MiB", "GiB"):
        if n < 1024 or unit == "GiB":
            return ("%.1f %s" % (n, unit)) if unit != "B" else ("%d B" % n)
        n /= 1024.0
    return "%d B" % n


def esc(s):
    return (s or "").replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


def _paths(win):
    return [win.filers[k].get() for k, _ in SLOTS if win.filers[k].get()]


USAGE = """Otter - GTK3 front end for the odin3-linux Samsung download-mode driver

usage: otter [--help] [--version]

Launch with no arguments; everything else happens in the window:

  Refresh / Probe         identify the phone (one session per Download mode)
  BL / AP / CP / CSC / UMS  pick firmware images
  Start                   runs every safety gate, confirms, then flashes

The driver is a separate program: `odin3-linux --help`.
Full workflow: README.md
"""


def main():
    args = sys.argv[1:]
    if any(a in ("-h", "--help") for a in args):
        print(USAGE)
        return 0
    if any(a in ("-V", "--version") for a in args):
        print("otter 1.0 - Odin3 3.14.4 download protocol")
        return 0
    if args:
        print("otter: unknown argument %r (try --help)" % args[0], file=sys.stderr)
        return 2

    win = Otter()
    win.show_all()
    # after the first layout pass, so real allocations exist to measure
    GLib.timeout_add(250, lambda: (win._fit_to_screen(), False)[1])
    GLib.timeout_add(800, lambda: (win._fit_to_screen(), False)[1])
    # find the phone on our own - Odin3 shows the COM port without being asked
    GLib.timeout_add(500, lambda: (win._run_list(), False)[1])
    Gtk.main()


if __name__ == "__main__":
    sys.exit(main())
