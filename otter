"""
Otter - a GTK3 front end for the odin3-linux Samsung download-mode driver,
laid out the way Odin3 itself is: pick files, tick options, press Start,
watch the log.

Otter contains no protocol code.  Every action is a subprocess call to
`odin3-linux`, so all framing and every safety gate lives in one place and the
GUI cannot route around it.

Flow (the phone allows ONE session per Download-mode entry):

   1. Refresh   - find the device
   2. Probe     - read-only session: identity + device PIT     [phone]
   3. Pick BL / AP / CP / CSC / UMS
   4. Start     - runs every gate offline first, shows you what will be
                  written, and only then asks the phone            [phone]
"""

import importlib.machinery
import importlib.util
import os
import re
import shutil
import subprocess
import sys
import threading

import gi
gi.require_version("Gtk", "3.0")
from gi.repository import Gtk, GLib, Gdk, Pango

# slot key -> tooltip (same order as Odin3's button column)
SLOTS = [("BL", "Bootloader"), ("AP", "System / PDA"), ("CP", "Modem"),
         ("CSC", "Consumer software"), ("UMS", "User / patch")]

# the four options Odin3 shows, all OFF by default
OPTIONS = [("repartition", "Re-Partition"), ("reboot", "Auto Reboot"),
           ("lock", "Flash Lock"), ("erase", "Erase")]

# gate overrides - hidden behind "Advanced", because they exist only to
# bypass a refusal you have decided is wrong
ADVANCED = [("allow_critical", "Allow boot-critical partitions",
             "BOOTLOADER / TZSW / KEYSTORAGE / EFS ..."),
            ("allow_oversize", "Allow image bigger than the partition", ""),
            ("allow_model", "Allow a file named for another model", ""),
            ("allow_duplicate", "Allow two files for one partition", "")]


STATE_FILE = os.path.join(GLib.get_user_cache_dir(), "otter-state")


def find_driver():
    here = os.path.dirname(os.path.abspath(__file__))
    for cand in (os.environ.get("OTTER_DRIVER"),
                 os.path.join(here, "odin3-linux"),
                 os.path.join(os.path.dirname(here), "odin3-linux"),
                 shutil.which("odin3-linux")):
        if cand and os.path.isfile(cand) and os.access(cand, os.X_OK):
            return cand
    return None


class Slot:
    """One BL/AP/CP/CSC/UMS row: checkbox + path + browse.

    Exposes get()/set() so callers (and the test) treat it like a plain
    file field.
    """

    def __init__(self, key, entry, check, clear):
        self.key, self.entry, self.check, self.clear = key, entry, check, clear
        self.path = None

    def get(self):
        p = self.entry.get_text().strip()
        if not p or not self.check.get_active():
            return None
        return p

    def set(self, path):
        self.path = path
        self.entry.set_text(path or "")
        self.check.set_sensitive(bool(path))
        self.check.set_active(bool(path))
        self.clear.set_sensitive(bool(path))
        self.entry.set_placeholder_text("no file selected")
        if hasattr(self, "on_change"):
            self.on_change()


